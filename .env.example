# Copy this file to .env.local and fill in your Supabase project values.
# Both values are free — find them in: Supabase Dashboard → Project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# No other keys needed. All features (auth, DB, storage, edge functions,
# realtime, in-app notifications, AI study buddy) run on Supabase's free tier.
